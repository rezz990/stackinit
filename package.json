{
  "name": "stackinit",
  "version": "0.1.0",
  "description": "CLI for creating and validating Next.js projects with optional Supabase and Prisma integration.",
  "type": "module",
  "bin": {
    "stackinit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "cli",
    "nextjs",
    "prisma",
    "supabase",
    "scaffolding"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/bun": "latest",
    "@types/node": "^26.4.1",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "license": "MIT"
}
