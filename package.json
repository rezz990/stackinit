{
  "name": "stackinit",
  "version": "0.1.0",
  "description": "A modern CLI for bootstrapping and managing application stacks.",
  "type": "module",
  "bin": {
    "stackinit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outfile=dist/index.js",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
