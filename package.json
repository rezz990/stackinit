{
  "name": "stackinit",
  "version": "0.1.0",
  "description": "A modular CLI for scaffolding and validating modern application stacks.",
  "type": "module",
  "bin": {
    "stackinit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun test",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "nextjs",
    "project-generator",
    "prisma",
    "scaffolding",
    "supabase",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezz990/stackinit.git"
  },
  "homepage": "https://github.com/rezz990/stackinit#readme",
  "bugs": {
    "url": "https://github.com/rezz990/stackinit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/bun": "latest",
    "@types/node": "^26.4.1",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "license": "MIT"
}
